[Unit]
Description=Start the supportbridge server application and listen to incoming connections on port 8091
After=multi-user.target network.target
 
[Service]
Type=simple
Environment="RUST_LOG=info"
Restart=on-failure
RestartSec=3s
ExecStart=/usr/bin/supportbridge serve --bind [::]:8091
 
[Install]
WantedBy=multi-user.target
